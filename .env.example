# Optional overrides for the Supabase connection.
#
# These are NOT required. src/lib/supabase.ts ships sensible defaults so the web
# app, the iPad PWA and the Android APK all work with no configuration.
#
# Copy this file to `.env` to point a local build at a different project.
#
# The publishable key is designed to be public — it is safe in a client bundle
# *only* because Row-Level Security (supabase/schema.sql) restricts writes to
# signed-in users. Never put a `service_role` / secret key here: that bypasses
# RLS completely and would give anyone who opens the app full write access.

VITE_SUPABASE_URL=https://iixacidjgxqqbhqgouvw.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_aJQ9ErOuU_JX19Nm85-wJA_xZNZALjZ
